<p>Hello <%= name %>,</p>

<p>
  Welcome to <%= appName %>! Your <%= accountType %> account has been created by the administrator.
</p>

<p>
  <strong>Your login credentials:</strong>
</p>

<p>
  <strong>Email:</strong> <%= email %><br />
  <strong>Password:</strong> <%= password %>
</p>

<% if (accountType === 'staff') { %>
<p>Please download the <strong>Vital Hands App</strong> from the App Store or Google Play Store to log in to your account.</p>
<% } else { %>
<p>You can now log in to your account using the link below:</p>

<p>
  <a href="<%= loginUrl %>">Login to Your Account</a>
</p>
<% } %>

<p>
  <strong>Important:</strong> Please change your password after your first login
  for security purposes.
</p>

<p>
  Regards,<br />
  <%= appName %> Team
</p>
